{
  "name": "pactra",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @pactra/web --filter @pactra/worker dev",
    "build": "pnpm --filter @pactra/web build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "db:generate": "node scripts/database.mjs generate",
    "db:migrate": "node scripts/database.mjs migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "test:e2e": "playwright test",
    "verify:providers": "tsx scripts/verify-providers.ts",
    "setup:owner": "node scripts/setup-owner.mjs",
    "verify:discovery": "tsx scripts/verify-discovery.ts",
    "verify:flights": "tsx scripts/verify-flights.ts",
    "status:payments": "tsx scripts/payment-status.ts",
    "catalog:prepare": "tsx scripts/prepare-catalog.ts"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@playwright/test": "1.64.1",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "dependencies": {
    "dotenv": "18.0.8",
    "csv-parse": "7.0.3"
  },
  "type": "module"
}
