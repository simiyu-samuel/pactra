# Copy to .env.local in the repository root. Never commit the populated file.
DATABASE_URL=postgresql://pactra:pactra@127.0.0.1:55439/pactra
TEST_DATABASE_URL=postgresql://pactra:pactra@127.0.0.1:55439/pactra_test
PUBLIC_APP_URL=http://localhost:3100

# Groq free-tier only. No automatic paid provider fallback.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TOKENS_PER_MINUTE=6800
GROQ_TOKENS_PER_DAY=170000
GROQ_REQUESTS_PER_MINUTE=25
GROQ_REQUESTS_PER_DAY=850

# PayPal SANDBOX business app. Client ID is public; the secret is server-only.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_EXPECTED_MERCHANT_ID=
# Register an HTTPS /api/webhooks/paypal endpoint before live webhook checks.
PAYPAL_WEBHOOK_ID=
